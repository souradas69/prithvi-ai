rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents: each account can access only its own profile.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Farm records created by the web platform use ownerUid for ownership.
    match /farms/{farmId} {
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // AI conversation history is private to its owner.
    match /conversations/{conversationId} {
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // Crop scan reports are private to the farmer who created them.
    match /cropScans/{scanId} {
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // Farmer Profile Security Rules
    match /farmers/{farmerId} {
      allow read, create, update, delete: if isOwner(farmerId);
    }

    // Community Posts Security Rules
    match /community_posts/{postId} {
      // Anyone (authenticated or public) can read published farm community posts
      allow read: if true;

      // Only authenticated farmers can create posts, and author UID must match caller
      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000;

      // Only author can update or delete their own post; likes counter can be incremented
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.authorUid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedByUserIds'])
      );

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.authorUid;

      // Nested Comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0;
        allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.authorUid;
      }
    }
  }
}
